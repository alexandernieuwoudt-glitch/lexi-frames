<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>LexiFrames.ico</ApplicationIcon>
    <Product>Lexi Frames</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) 2026 Alex. MIT License.</Copyright>
    <AssemblyTitle>Lexi Frames</AssemblyTitle>
    <AssemblyName>LexiFrames</AssemblyName>
    <RootNamespace>LexiFrames</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.2" />
  </ItemGroup>

</Project>
